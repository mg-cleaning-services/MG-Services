  "rewrites": [
    {
      "source": "/team/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/request-service",
      "destination": "/index.html"
    },
    {
      "source": "/apply",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    }
  ]
}
